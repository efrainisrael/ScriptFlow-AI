# Salin file ini ke .env.local lalu isi nilainya. JANGAN commit kunci asli.
# Custom LLM Endpoint (Ollama, vLLM, HuggingFace TGI, LM Studio, OpenAI, dll)
LLM_API_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL_NAME=scriptflow-custom-llm

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (pipeline AI, panel admin). Jangan diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
